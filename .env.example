# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The origin emailed auth links should come back to.
# Set this in Vercel to https://interiorstudioos.com so a reset link is
# always a production link, whichever build sent it. Leave it unset
# locally and it falls back to the current origin.
#
# This only controls what we ASK for — Supabase still validates it
# against Authentication > URL Configuration > Redirect URLs, and
# silently falls back to Site URL when it does not match.
VITE_SITE_URL=
